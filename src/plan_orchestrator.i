                    const auto _Offset = _It == _Ls_vector.begin() ? seconds{0} : ::std:: _Prev_iter(_It)->_Elapsed();
                    _Dur += ::std::chrono:: duration_cast<_DurationType>(_Offset);

                    if (_Original_leap == _Leap_second_rep::_File_time) {
                        _Dur -= ::std::chrono:: duration_cast<_DurationType>(
                            filesystem::_File_time_clock::_Skipped_filetime_leap_seconds);
                    }
                }
            }

            return true;
        }

