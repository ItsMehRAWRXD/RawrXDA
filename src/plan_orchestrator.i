                return;
            }

            if (::std:: filesystem::is_directory(_Tstat._Status)) {
                
                ::std:: filesystem::copy_file(_From, _To / _From.path().filename(), _Options, _Ec);
                return;
            }

            
            ::std:: filesystem::copy_file(_From, _To, _Options, _Ec);
            return;
        }

        
