                _Leap =
                    _Dur < file_clock::_Cutoff.time_since_epoch() ? _Leap_second_rep::_None : _Leap_second_rep::_All;
            }

            if (_Second > (_Leap == _Leap_second_rep::_All ? 60 : 59)) {
