                         != copy_options::none; 
        const auto _Fstat = _From._Get_any_status(_Flink ? _Symlink_status_stats_flags : _Status_stats_flags);
        if (_Fstat._Error != __std_win_error::_Success) { 
            _Ec = _Make_ec(_Fstat._Error);
            return;
        }

