    std::ostringstream stream;
    for (std::size_t index = 0; index < m_executionObservations.size(); ++index) {
        if (index > 0) {
            stream << '\n';
        }
        stream << m_executionObservations[index];
    }

    m_executionObservations.clear();
    return stream.str();
}

